# ---------------------------------------------------------------------------
# Provider API keys (server-side fallback).
# Users can also paste their own keys in the in-app Settings panel, which
# override these. At least one provider key is needed for analysis.
# ---------------------------------------------------------------------------

# Google AI Studio key — https://aistudio.google.com/apikey
# Also powers the premium (high quality) text-to-speech playback.
GEMINI_API_KEY=""

# OpenRouter key — https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# ---------------------------------------------------------------------------
# Optional: override the actual model identifiers per provider.
# Defaults live in src/lib/models.ts. Set these only if a provider renames a
# model and you need to correct it without changing code.
# ---------------------------------------------------------------------------
# GOOGLE_MODEL_FLASH_LITE="gemini-3.1-flash-lite"
# GOOGLE_MODEL_GEMMA="gemma-4-31b"
# OPENROUTER_MODEL_FLASH_LITE="google/gemini-3.1-flash-lite"
# OPENROUTER_MODEL_GEMMA="google/gemma-4-31b"
# GEMINI_TTS_MODEL="gemini-3.1-flash-tts-preview"

# Optional: public URL of the deployment (used as the OpenRouter referer).
# APP_URL="https://your-app.vercel.app"
