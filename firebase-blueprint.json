{
  "entities": {
    "question": {
      "title": "Saved Question",
      "description": "A saved study card, passage, or PTE question in the learning history.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the question card"
        },
        "userId": {
          "type": "string",
          "description": "UID of the owner user"
        },
        "title": {
          "type": "string",
          "description": "Title of the study item or passage"
        },
        "category": {
          "type": "string",
          "enum": ["FIB-R", "FIB-RW", "RO", "MCQ", "TXT"],
          "description": "Target PTE category"
        },
        "date": {
          "type": "string",
          "description": "Human-readable creation or study date"
        },
        "timestamp": {
          "type": "number",
          "description": "Epoch timestamp of the study state"
        },
        "note": {
          "type": "string",
          "description": "User notes and takeaways"
        },
        "status": {
          "type": "string",
          "enum": ["needs-review", "mastered", "critical"],
          "description": "Progress rating status"
        },
        "images": {
          "type": "array",
          "description": "Compressed base64 images"
        },
        "rawResponse": {
          "type": "string",
          "description": "Stored JSON payload string from Gemini"
        },
        "isStarred": {
          "type": "boolean",
          "description": "Whether marked as starred"
        }
      },
      "required": ["id", "userId", "title", "category", "timestamp", "status", "rawResponse"]
    }
  },
  "firestore": {
    "questions/{questionId}": {
      "schema": "question",
      "description": "Store all saved questions/study cards per user"
    }
  }
}
